@model Facturacion_Electronica.Models.NotaCredito.ModeloImpresionNotaCredito
@{

}

@Html.HiddenFor(model => model.NotaCredito.id, new { id = "nota-id", Value = Model.NotaCredito.id})

@Scripts.Render("~/bundles/jquery")
<script type="text/javascript">
    $(document).ready(function () {
        PrintSale();
    });

    function PrintSale() {
        var id = $("#nota-id").val();
        window.open("/NotaCredito/Index/", "_self");
        window.open("/NotaCredito/Impresion/" + id, "", 1200, 1000);
        return false;
    }
</script>