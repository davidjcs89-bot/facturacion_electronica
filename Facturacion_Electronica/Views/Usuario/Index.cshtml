@using Facturacion_Electronica.Business;
@model Facturacion_Electronica.Models.Usuario.ModeloBuscarUsuario

@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Usuarios</h2>

<div class="row">
    <div class="col-md-6">
        <h3>Usuarios Activos: @ViewBag.UsuariosActivos</h3>
    </div>
    <div class="col-md-6">
        <h3>Usuarios Inactivos: @ViewBag.UsuariosInactivos</h3>
    </div>
</div>

<br />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="container" style="border-style: solid;">

        <fieldset>
            <legend>Busqueda de Usuarios</legend>
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    @Html.LabelFor(model => model.BuscarPorNombre, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.BuscarPorNombre, new { htmlAttributes = new { @class = "form-control", @id = "buscar-id" } })

                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.BuscarPorApellido, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.BuscarPorApellido, new { htmlAttributes = new { @class = "form-control", @id = "buscar-nombre" } })

                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.BuscarPorEmail, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.BuscarPorEmail, new { htmlAttributes = new { @class = "form-control", @id = "buscar-nombre" } })

                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-2">Buscar por Estado</label>
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.BuscarPorEstado, (IEnumerable<SelectListItem>)ViewBag.estados, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.BuscarPorEstado, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-7">
                                @Html.LabelFor(model => model.BuscarTodos, htmlAttributes: new { @class = "control-label", @style = "padding-right: 10px" })

                                @Html.EditorFor(model => model.BuscarTodos)

                            </div>
                            <div class="col-md-5">

                            </div>
                        </div>


                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input id="btn-buscar" type="submit" value="Buscar" class="btn btn-default" />
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="table-responsive">
        <table class="table">
            <tr>
                <th></th>
                <th>#</th>
                <th>
                    Nombre Usuario
                </th>
                <th>
                    Correo
                </th>
                <th>
                    Número Telefonico
                </th>
                <th>
                    Emisor
                </th>
                <th>
                    Nombre
                </th>
                <th>
                    Apellido
                </th>
                <th>
                    Estado
                </th>
                <th>
                    Fecha Creación
                </th>
                <th>
                    Fecha Modificación
                </th>

            </tr>

            @{
                var indice = 1;
            }

            @foreach (var item in Model.Usuarios)
            {

                var colorFila = "white";

                if (item.Estado == 2)
                {
                    colorFila = "#faaa99";
                }

                <tr style="background-color:@colorFila">
                    <td>
                        <button type="button" id="editarUsuario" class="btn btn-info btn-editar" data-target="#editarProforma" onclick="window.open('@Url.Action("Edit", "Usuario", new { id = item.id, target = "_blank" })')">
                            Editar
                        </button>
                    </td>
                    <td>@indice</td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre_usuario)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Correo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Numero_telefono)
                    </td>

                    @{
                        var emisor = "No configurado";
                        if (item.Emisor != null)
                        {
                            emisor = item.Emisor.Ruc + "<br/>" + item.Emisor.Nombre_comercial;
                        }
                    }
                    <td>
                        @Html.Raw(emisor)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Apellido)
                    </td>

                    <td>
                        @{
                            var estadoDescr = item.Estado == (int)EnumEstadoUsuario.ACTIVO ? "ACTIVO" : "INACTIVO";
                        }

                        @Html.DisplayFor(modelItem => estadoDescr)
                    </td>


                    <td>
                        @Html.DisplayFor(modelItem => item.Fecha_creacion)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Fecha_modificacion)
                    </td>




                </tr>

                indice++;

            }

        </table>
    </div>

}