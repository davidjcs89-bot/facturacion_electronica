@model Facturacion_Electronica.Models.LiquidacionCompra.ModeloLiquidacionPago
@{
    Layout = null;
}

@using (Html.BeginForm("AgregarPago", "LiquidacionCompra", null, FormMethod.Post, new { id = "frm-agregar-pago", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    <div class="modal-body">
        @Html.HiddenFor(modelo => modelo.IdFactura)
        <div class="form-group">
            <div class="col-md-12">
                @Html.LabelFor(model => model.IdFormaPago, htmlAttributes: new { @class = "control-label" })
                @Html.DropDownListFor(model => model.IdFormaPago, (IEnumerable<SelectListItem>)ViewBag.FormasPago, null, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Valor, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.Valor, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Valor, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Tiempo, htmlAttributes: new { @class = "control-label" })
                @Html.DropDownListFor(model => model.Tiempo, (IEnumerable<SelectListItem>)ViewBag.Tiempos, null, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Plazo, htmlAttributes: new { @class = "control-label" })
                @Html.EditorFor(model => model.Plazo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Plazo, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <div class="col-md-offset-2 col-md-10">
            <input type="button" value="Agregar" class="btn btn-default" onclick="AgregarPago();" />
        </div>
    </div>
}

