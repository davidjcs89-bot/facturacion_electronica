@model Facturacion_Electronica.Models.Impresion.ModeloConfigImpresion
@{
    ViewBag.Title = "Configuración Impresion";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Configuración de Impresión</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <div class="form-horizontal">
            <div class="form-group">
                @Html.LabelFor(model => model.IdTipoComprobante, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownListFor(model => model.IdTipoComprobante, (IEnumerable<SelectListItem>)ViewBag.TipoComprobante, null, new { @class = "form-control", @id = "lista-documentos" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Firma, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.CheckBoxFor(model => model.Firma, new { htmlAttributes = new { @class = "form-control", @id = "firma" } })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Mensajes, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.Mensajes, new { @class = "form-control", @id = "mensajes" })
                    @Html.ValidationMessageFor(model => model.Mensajes, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-default">Guardar</button>
}
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/ImpresionJs")