@{
    ViewBag.Title = "Facturacion Electronica";

    <head>
        <title>Facturacion Electronica</title>
        <link href="~/Content/bootstrap-car.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
    </head>

    <body>
        <nav class="navbar-home">
            <div class="navbar-icon">
                <a href="#">
                    <img src="~/Content/Imagenes/logo.png" alt="Alternate Text" />
                    <span>Si Do It</span>
                </a>
            </div>
            <ul class="navbar-links">
                <!-- <li><a href="#">Inicio</a></li>
                 <li><a href="#">Acerca</a></li>
                 <li><a href="#">Servicios</a></li>
                 <li><a href="#">Contacto</a></li>-->
            </ul>
        </nav>
        <div class="general-container">

            <div class="banner">
                <div class="banner-container">
                    <div class="banner-content">
                        <h1>Factura con Claridad, Optimiza tu Tiempo, Marca la Diferencia con Si Do It</h1>

                        <p>
                            Descubre la solución definitiva para la gestión de tus comprobantes.
                            Con Si Do It, la opción simple pero eficaz, podrás generar tus
                            comprobantes de manera sencilla, rápida y clara. Simplifica tus
                            procesos de facturación y optimiza tu tiempo con nuestra plataforma
                            intuitiva y poderosa. ¡Si Do It es la clave para una facturación más
                            eficiente y sin complicaciones! ¿Qué esperas? ¡Empieza ya!
                        </p>

                        <div class="banner-buttons">
                            <button class="btn-register" onclick="location.href='/Usuario/Create'">Registrarse</button>
                            <button class="btn-signin" onclick="location.href='/Login/Login'">Iniciar Sesión</button>
                        </div>
                    </div>



                    <div class="banner-img">
                        <img src="~/Content/Imagenes/invoice-banner.svg" alt="bannerimg" />
                    </div>
                </div>
            </div>

            <div class="notices">
                @if (ViewBag.Avisos != null)
                {
                    <div class="card" style="font-size:14px;">
                        <div class="card-header">
                            Avisos
                        </div>
                        @foreach (string aviso in ViewBag.Avisos)
                        {
                            <div class="card-body">
                                <p class="card-text">* @aviso</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </body>

    @section Styles {
        @Styles.Render("~/bundles/HomeCSS")
    }

}
