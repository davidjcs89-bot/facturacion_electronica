@model Facturacion_Electronica.Models.Compra.ModeloCompraXml
@{
    ViewBag.Title = "Compra";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Nueva Compra</h2>

@using (Html.BeginForm("CreateCompra", "Compra", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="text-right">
        <input type="submit" value="Guardar" class="btn btn-info" />
    </div>
    <br />
    @Html.ValidationMessage(string.Empty)
    <div class="container">
        <div class="row">
            <div class="col-md-12" style="border-style: solid;">
                <fieldset>
                    <legend>Datos del Proveedor</legend>
                    <div class="form-horizontal">
                        <div class="form-group">
                            @Html.LabelFor(model => model.DatosTributarios.Ruc, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.DatosTributarios.Ruc, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.DatosTributarios.Ruc, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DatosTributarios.RazonSocial, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.DatosTributarios.RazonSocial, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.DatosTributarios.RazonSocial, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DatosTributarios.DireccionMatriz, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.DatosTributarios.DireccionMatriz, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.DatosTributarios.DireccionMatriz, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-md-12" style="border-style: solid;">
                <fieldset>
                    <legend>Datos de la Factura</legend>
                    <div class="form-horizontal">
                        <div class="form-group">
                            @Html.LabelFor(model => model.DatosTributarios.CodigoEstablecimiento, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.DatosTributarios.CodigoEstablecimiento, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.DatosTributarios.CodigoEstablecimiento, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DatosTributarios.CodigoEmision, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.DatosTributarios.CodigoEmision, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.DatosTributarios.CodigoEmision, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DatosTributarios.Secuencial, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.DatosTributarios.Secuencial, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.DatosTributarios.Secuencial, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DatosTributarios.ClaveAcceso, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.DatosTributarios.ClaveAcceso, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.DatosTributarios.ClaveAcceso, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Factura.FechaEmision, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.Factura.FechaEmision, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.Factura.FechaEmision, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Factura.TotalSinImpuestos, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.Factura.TotalSinImpuestos, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.Factura.TotalSinImpuestos, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Factura.TotalDescuento, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.Factura.TotalDescuento, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.Factura.TotalDescuento, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Factura.Total, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10 ">
                                @Html.EditorFor(model => model.Factura.Total, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.Factura.Total, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <br />
                        <strong>Impuestos de Factura</strong>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <td>C&oacute;digo</td>
                                        <td>C&oacute;digo Porcentaje</td>
                                        <td>Base Imponible</td>
                                        <td>Valor</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Factura.Impuestos.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                @Html.EditorFor(model => model.Factura.Impuestos[i].Codigo, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.Factura.Impuestos[i].Codigo, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.EditorFor(model => model.Factura.Impuestos[i].CodigoPorcentaje, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.Factura.Impuestos[i].CodigoPorcentaje, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.EditorFor(model => model.Factura.Impuestos[i].BaseImponible, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.Factura.Impuestos[i].BaseImponible, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.EditorFor(model => model.Factura.Impuestos[i].Valor, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.Factura.Impuestos[i].Valor, "", new { @class = "text-danger" })
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </fieldset>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-md-12" style="border-style: solid;">
                <fieldset>
                    <legend>Detalle  de la Factura</legend>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <td>C&oacute;digo</td>

                                    <td>Descripci&oacute;n</td>

                                    <td>Cantidad</td>

                                    <td>Precio</td>

                                    <td>Descuento</td>

                                    <td>Precio sin impuesto</td>
                                    <td>Impuestos</td>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Detalles.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Html.EditorFor(model => model.Detalles[i].Codigo, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                            @Html.ValidationMessageFor(model => model.Detalles[i].Codigo, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.Detalles[i].Descripcion, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                            @Html.ValidationMessageFor(model => model.Detalles[i].Descripcion, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.Detalles[i].Cantidad, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                            @Html.ValidationMessageFor(model => model.Detalles[i].Cantidad, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.Detalles[i].Precio, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                            @Html.ValidationMessageFor(model => model.Detalles[i].Precio, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.Detalles[i].Descuento, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                            @Html.ValidationMessageFor(model => model.Detalles[i].Descuento, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.Detalles[i].PrecioSInImpuestos, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                            @Html.ValidationMessageFor(model => model.Detalles[i].PrecioSInImpuestos, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <td>C&oacute;digo</td>
                                                        <td>C&oacute;digo Porcentaje</td>
                                                        <td>Base imponible</td>
                                                        <td>Tarifa</td>
                                                        <td>Valor</td>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int j = 0; j < Model.Detalles[i].Impuestos.Count; j++)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.EditorFor(model => model.Detalles[i].Impuestos[j].Codigo, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                                @Html.ValidationMessageFor(model => model.Detalles[i].Impuestos[j].Codigo, "", new { @class = "text-danger" })
                                                            </td>
                                                            <td>
                                                                @Html.EditorFor(model => model.Detalles[i].Impuestos[j].CodigoPorcentaje, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                                @Html.ValidationMessageFor(model => model.Detalles[i].Impuestos[j].CodigoPorcentaje, "", new { @class = "text-danger" })
                                                            </td>
                                                            <td>
                                                                @Html.EditorFor(model => model.Detalles[i].Impuestos[j].BaseImponible, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                                @Html.ValidationMessageFor(model => model.Detalles[i].Impuestos[j].BaseImponible, "", new { @class = "text-danger" })
                                                            </td>
                                                            <td>
                                                                @Html.EditorFor(model => model.Detalles[i].Impuestos[j].Tarifa, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                                @Html.ValidationMessageFor(model => model.Detalles[i].Impuestos[j].Tarifa, "", new { @class = "text-danger" })
                                                            </td>
                                                            <td>
                                                                @Html.EditorFor(model => model.Detalles[i].Impuestos[j].Valor, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                                @Html.ValidationMessageFor(model => model.Detalles[i].Impuestos[j].Valor, "", new { @class = "text-danger" })
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>


                </fieldset>

            </div>

        </div>
    </div>
}
