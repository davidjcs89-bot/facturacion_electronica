
@{
    ViewBag.Title = "Cargar Compra";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Importar Compra</h2>
<br />
@using (Html.BeginForm("Index", "Compra", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div class="text-center">
            <small class="text-danger" style="font-style:italic">*** Solo se puede importar facturas descargadas del SRI. No las que llegan directamente del Vendedor ***</small>
            <br />
            <br />

        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Seleccionar Archivo:</label>
            <div class="col-md-7">
                <input type="file" id="archivo" name="archivo" accept=".xml" />
                @if (ViewBag.Error != null)
                {
                    <label class="control-label text-danger">@ViewBag.Error</label>
                }

            </div>
            <div class="col-md-3 pull-right">
                <button type="submit" class="btn btn-info">Cargar</button>
            </div>
        </div>
    </div>
}

