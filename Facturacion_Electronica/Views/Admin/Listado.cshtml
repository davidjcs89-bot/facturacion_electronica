@model List<Facturacion_Electronica.Models.ModeloComprobanteReporte>
@{
    ViewBag.Title = "Facturacion Electronica";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="container" id="listado">
    <h2>Noticias</h2>
    <hr />

    @foreach (var docuemnto in Model)
    {
        <div class="row">
            <div class="col-md-4">
                <div class="row">
                    <div class="col-md-12">
                        <strong>Transacción:</strong> @docuemnto.Documento
                    </div>
                    <div class="col-md-12">
                        <strong>Nombre:</strong> @docuemnto.Cliente
                    </div>
                </div>

            </div>
            <div class="col-md-4"><strong>Fecha:</strong>@docuemnto.Fecha</div>
            <div class="col-md-4"><strong>Valor:</strong> $@docuemnto.Valor.ToString()</div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @if (docuemnto.Imagen != null)
                {
                    <div class="form-group">
                        <div class="col-md-10">
                            @{
                                var base64 = Convert.ToBase64String(docuemnto.Imagen);
                                var imgSrc = String.Format("data:image/gif;base64,{0}", base64);
                            }

                            <img src="@imgSrc" style="width:300px" />
                            <button class="btn btn-default" onclick="ObtenerImagnesComprobante('@docuemnto.UrlImagenes')">Imagenes</button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-default" onclick="ObtenerImagnesComprobante(@docuemnto.UrlImagenes)">Imagenes</button>
                }

            </div>

            <div class="col-md-6">
                <a href="@docuemnto.Url" target="_blank">Detalles</a>
            </div>
        </div>
        <hr />

    }
    <div class="text-center">
        <button class="btn btn-info" onclick="CargarListaDesdeBoton()"><i class="fa fa-arrow-down" style="font-size:40px"></i></button>
    </div>
</div>


@section BodyArea {
    <div id="imagenes-modal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="add-item" data-keyboard="true" data-backdrop="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">Imagenes</h4>
                </div>
                <div id="imagenes-contenedor">

                </div>
            </div>
        </div>
    </div>
}
@Scripts.Render("~/bundles/jquery")
<script type="text/javascript">
    var numData = 5;

    $(document).ready(function () {

        var inProgress = false;
        /* $(window).scroll(function () {
         if ($(window).scrollTop() == $(document).height() -
         $(window).height()) {

             inProgress = true;
             $("#loadingDiv").show();
             //$.post(Url.Action("Listado", "Admin")?numero='+numData).always(function(){
                 $('#listado').load('/Admin/Listado?numero='+numData);
                 numData += 5;
             //});
         }
         });*/

    });

    function CargarListaDesdeBoton() {
        inProgress = true;
        $("#loadingDiv").show();
        //$.post(Url.Action("Listado", "Admin")?numero='+numData).always(function(){
        $("#listado").html("");
        $('#listado').load('/Admin/Listado?numero=' + numData);
        numData += 5;
    }

    function ObtenerImagnesComprobante(url, id) {
        console.log(url);
        $("#imagenes-contenedor").empty();
        $.ajax({
            type: "GET",
            url: url,
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "html",
            success: function (response) {
                $("#imagenes-contenedor").html("");
                $("#imagenes-contenedor").html(response);
                $("#imagenes-modal").appendTo("body").modal("show");
            },
            failure: function (response) {
                alert(response.responseText);
                alert("error ");
            },
            error: function (response) {
                alert(response.responseText);
            }
        });
    }
</script>
