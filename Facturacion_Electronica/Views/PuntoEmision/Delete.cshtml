@model Facturacion_Electronica.Puntos_emisior

@{
    ViewBag.Title = "Eliminar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3>Est&aacute;s seguro que deseas eliminar este Punto de Emisi&oacute;n?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">

        @Html.ValidationMessageFor(model => model.id, "", new { @class = "text-danger" })

        <hr />

        <dt>
            N&uacute;mero de Establecimiento
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Numero_establecimiento)
        </dd>

        <dt>
            N&uacute;mero de Emisi&oacute;n
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Numero_emision)
        </dd>

        <dt>
            Direcci&oacute;n
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Direccion)
        </dd>

        <dt>
            Fecha de Creaci&oacute;n
        </dt>

        <dd>
            @{
                string fechaCreacion = Model.Fecha_creacion.ToString("dd/MM/yyyy HH:mm");
            }
            @Html.DisplayFor(model => fechaCreacion)
        </dd>

        <dt>
            Fecha de Modificaci&oacute;n
        </dt>

        <dd>
            @{
                string fechaModificacion = Model.Fecha_modificacion.ToString("dd/MM/yyyy HH:mm");
            }
            @Html.DisplayFor(model => fechaModificacion)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-default" /> |
            @Html.ActionLink("Regresar", "Index")
        </div>
    }
</div>
