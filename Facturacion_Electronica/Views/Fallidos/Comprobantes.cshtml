@model Facturacion_Electronica.Models.Comprobantes.ModeloBusquedaComprobateNoAutorizado
@{
    ViewBag.Title = "Comprontes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2></h2>
@using (Html.BeginForm())
{

    @Html.AntiForgeryToken()
    <div class="container" style="border-style: solid;">
        <fieldset>
            <legend>Busqueda de Comprobantes No Autorizados</legend>
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    <label class="control-label col-md-2">Fecha Desde:</label>
                    <div class="input-group date datePickerBasicDate col-md-3">
                        @Html.EditorFor(model => model.BuscarFechaDesde, new { htmlAttributes = new { @class = "form-control", Value = ViewBag.FechaDesde, @type = "text" } })
                        <span class="input-group-addon">
                            <span class="fa fa-calendar"></span>
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-2">Fecha Hasta:</label>
                    <div class="input-group date datePickerBasicDate col-md-3">
                        @Html.EditorFor(model => model.BuscarFechaHasta, new { htmlAttributes = new { @class = "form-control", Value = ViewBag.FechaHasta, @type = "text" } })
                        <span class="input-group-addon">
                            <span class="fa fa-calendar"></span>
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input id="btn-buscar" type="submit" value="Buscar" class="btn btn-default" />
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="table-responsive">
        <table class="table">
            <tr>
                <th>
                    Tipo Comprobante
                </th>
                <th>
                    N&uacute;mero Comprobante
                </th>
                <th>
                    Fecha Modificacion
                </th>
                <th>
                    Mensajes
                </th>
                <th></th>
            </tr>

            @foreach (var item in Model.Comprobantes)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.tipo_comprobantes)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Numero)
                    </td>
                    <td>
                        @Convert.ToDateTime(item.fecha_modificacion).ToString("dd/MM/yyyy HH:mm")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.mensajes)
                    </td>
                </tr>
            }

        </table>
    </div>
}
@section Styles {
    @Styles.Render("~/bundles/datetimePickerCss")
}
@Scripts.Render("~/bundles/moment")
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/datetimePicker")