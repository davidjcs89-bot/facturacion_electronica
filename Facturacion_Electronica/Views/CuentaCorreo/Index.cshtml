@model Facturacion_Electronica.Models.ModeloCuentaCorreo

@{
    ViewBag.Title = "Cuenta de Correo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Correo Electrónico</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <label class="control-label col-md-2">Dirección de Correo</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.direccion, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.direccion, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Nombre de visualización</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.nombre_mostrar, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.nombre_mostrar, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Servidor SMTP</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.servidor, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.servidor, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Puerto</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.puerto, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.puerto, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Usar SSL</label>
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.ssl, new { htmlAttributes = new { @style = "margin-left:0px" } })
                    @Html.ValidationMessageFor(model => model.ssl, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Contraseña</label>
            <div class="col-md-10">
                @Html.PasswordFor(model => model.clave, htmlAttributes: new { @class = "form-control " })
                @Html.ValidationMessageFor(model => model.clave, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Guardar" class="btn btn-default" />
            </div>
        </div>
    </div>
}
