@model Facturacion_Electronica.Models.Cliente.ModeloCliente

@{
    Layout = null;
}

@using (Html.BeginForm("Create", "Cliente", null, FormMethod.Post, new { id = "frm-nuevo-cliente", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.OrigenPenticionNuevoCliente)
            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.RazonSocial, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.RazonSocial, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.RazonSocial, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12">
                    @Html.LabelFor(model => model.TipoIdentificacionId, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.TipoIdentificacionId, (IEnumerable<SelectListItem>)ViewBag.TipoIdentificacion, null, new { @class = "form-control", id = "tipoIdentificacionDropdown", onchange = "validarTipoIdentificacion()" })
                    @Html.ValidationMessageFor(model => model.TipoIdentificacionId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12">
                    @Html.LabelFor(model => model.NumeroIdentificacion, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.NumeroIdentificacion, new { htmlAttributes = new { @class = "form-control", id = "numeroIdentificacionInput", oninput = "validarNumeroIdentificacion()" } })
                    <span id="numeroIdentificacionError" class="text-danger"></span>
                    @Html.ValidationMessageFor(model => model.NumeroIdentificacion, "", new { @class = "text-danger" })
                </div>
            </div>

            @*Solo al crear desde liquidacion de compra*@
            @if (Model.OrigenPenticionNuevoCliente == 3)
            {
                <div class="form-group" style="display:none">

                    <div class="col-md-12">
                        @Html.LabelFor(model => model.TipoClienteId, htmlAttributes: new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.TipoClienteId, (IEnumerable<SelectListItem>)ViewBag.TipoCliente, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.TipoClienteId, "", new { @class = "text-danger" })
                    </div>
                </div>
            }
            else
            {
                <div class="form-group">

                    <div class="col-md-12">
                        @Html.LabelFor(model => model.TipoClienteId, htmlAttributes: new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.TipoClienteId, (IEnumerable<SelectListItem>)ViewBag.TipoCliente, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.TipoClienteId, "", new { @class = "text-danger" })
                    </div>
                </div>
            }


            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.Direccion, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Direccion, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Direccion, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.Celular, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Celular, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Celular, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.TelefonoConvencional, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.TelefonoConvencional, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.TelefonoConvencional, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.Extension, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Extension, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Extension, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
        <div class="col-md-offset-2 col-md-10">
            <input type="button" value="Guardar" class="btn btn-default" onclick="CrearCliente();" />
        </div>
    </div>

}
@Scripts.Render("~/bundles/jqueryval")
@Scripts.Render("~/bundles/ClienteJs")
