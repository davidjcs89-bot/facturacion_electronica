@model Facturacion_Electronica.Models.Cliente.DatosAdicionalesCliente
@{
    ViewBag.Title = "Informacion Adicional Clientes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    table {
        table-layout: fixed;
        width: 100%
    }

        table td {
            width: 100px;
            word-wrap: break-word;
        }
</style>
<h2>Notas de Clientes</h2>

@using (Html.BeginForm("Notas", "Cliente", null, FormMethod.Post, new { id = "frm-nota-cliente", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.IdCliente);
    <div class="form-horizontal">
        <div class="form-group">

            <div class="col-md-12">
                <label class="control-label">Descripcion de la Nota</label>
                @Html.TextAreaFor(model => model.Nota, htmlAttributes: new { @class = "form-control " })
                @Html.ValidationMessageFor(model => model.Nota, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input id="btn-guardar" type="submit" value="Guardar" class="btn btn-default" />
            </div>
        </div>
    </div>


    <div class="form-group">
        <div >
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            Nota
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Notas)
                    {
                        <tr>
                            <td style=" word-wrap: break-word">
                                <span class="text-right" style="font-weight:bold;font-style:italic">
                                    @Html.DisplayFor(modelItem => item.fecha_creacion)
                                </span>
                                <br />
                                @Html.DisplayFor(modelItem => item.nota)
                            </td>
                            @*<button type="button" id="nuevoCliente" class="btn btn-danger" onclick="location.href='@Url.Action("EliminarNota", "Cliente",new { id = item.id})';return false;" data-target="#editarCliete">
                                    Eliminar
                                </button>*@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}