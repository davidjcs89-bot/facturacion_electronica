@model Facturacion_Electronica.Models.Cliente.ModeloFichaCliente
@{
    ViewBag.Title = "Ficha";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Ficha Cliente: @Model.Cliente</h2>
<br />
@using (Html.BeginForm("Ficha", "Cliente", null, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Id);

    <div class="form-horizontal">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" style="width:600px">
                <thead>
                    <tr>
                        <th style="text-align: center">
                            <h5>Atributo</h5>
                        </th>
                        <th style="text-align: center">
                            <h5>Valor</h5>
                        </th>
                    </tr>
                </thead>
                @for (var i = 0; i < Model.Atributos.Count; i++)
                {
                    @Html.HiddenFor(x => x.Atributos[i].Id);
                    @Html.HiddenFor(x => x.Atributos[i].IdAtributo);
                    @Html.HiddenFor(x => x.Atributos[i].NombreAtributo);
                    <tr style="text-align:center">
                        <td style="text-align:center">
                            @Html.DisplayFor(model => model.Atributos[i].NombreAtributo)
                        </td>
                        <td style="text-align:center">
                            @Html.TextAreaFor(model => model.Atributos[i].Valor, htmlAttributes: new { @class = "form-control " })
                            @Html.ValidationMessageFor(model => model.Atributos[i].Valor, "", new { @class = "text-danger" })
                        </td>
                    </tr>

                }
            </table>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Actualizar y Guardar" class="btn btn-default" />
            </div>
        </div>
    </div>
}

