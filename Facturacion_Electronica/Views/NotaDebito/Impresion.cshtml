@model Facturacion_Electronica.Models.NotaDebito.ModeloImpresionNotaDebito
@{
    Layout = null;
}
<html>
<head>
</head>
<body onload="window.print();">
    <div>
        <div>
            <table>
                <tr>
                    <td>
                        @Model.NotaDebito.Emisor.Razon_social
                    </td>
                </tr>
                <tr>
                    <td>
                        RUC: @Model.NotaDebito.Emisor.Ruc
                    </td>
                </tr>
                <tr>
                    <td>
                        Nota Debito#: @Model.NotaDebito.Numero
                    </td>
                </tr>
                <tr>
                    <td>
                        Clave Acceso:
                    </td>
                </tr>
                <tr>
                    <td style="font-size: small">
                        @Model.NotaDebito.Clave_acceso
                    </td>
                </tr>
            </table>
            <table>
                <tr>
                    @{
                        var date = Model.NotaDebito.Fecha_emision.ToString("dd/MM/yyyy-HH:mm:ss");
                    }
                    <td>Fecha Emisión: @Html.DisplayFor(model => date)</td>
                </tr>
                <tr>
                    <td>
                        Id Cliente: @Html.DisplayFor(model => model.NotaDebito.Clientes.identificacion)
                    </td>
                </tr>
                <tr>
                    <td>
                        Nombre Cliente: @Html.DisplayFor(model => model.NotaDebito.Clientes.nombre_cliente)
                    </td>
                </tr>
                <tr>
                    <td>
                        @{
                            string address = Model.NotaDebito.Clientes.Direccion;

                            if (address != null && Model.NotaDebito.Clientes.Direccion.Length > 20)
                            {
                                address = Model.NotaDebito.Clientes.Direccion.Substring(0, 20);
                            }
                        }
                        Dirección: @Html.DisplayFor(model => address)
                    </td>
                </tr>
                <tr>
                    <td>
                        Email
                    </td>
                </tr>
                <tr>
                    <td>
                        #Factura Modifica: @Html.DisplayFor(model => model.NotaDebito.Factura.Numero)
                    </td>
                </tr>
                <tr>
                    <td>
                        @{
                            var dateDev = Model.NotaDebito.Factura.Fecha_emision.ToString("dd/MM/yyyy-HH:mm:ss");
                        }
                        #Factura F.Emision: @Html.DisplayFor(model => dateDev)
                    </td>
                </tr>
                <tr>
                    <td>
                        @{
                            string email = Model.NotaDebito.Clientes.correo;

                            if (email != null && Model.NotaDebito.Clientes.correo.Length > 24)
                            {
                                email = Model.NotaDebito.Clientes.correo.Substring(0, 24);
                                email = email.ToUpper();
                            }
                            else
                            {
                                email = "";
                            }
                        }
                        @Html.DisplayFor(model => email)
                    </td>
                </tr>
            </table>
        </div>
        <table>
            <thead>
                <tr>
                    <th>
                        Motivo
                    </th>
                    <th>
                        Valor
                    </th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model.NotaDebito.Detalle_nota_debito.ToList())
                {
                    <tr>
                        <td style="text-align: center">
                            @Html.DisplayFor(model => item.Razon_modificacion)
                        </td>
                        <td style="text-align: center">
                            @Html.DisplayFor(model => item.Valor_modificacion)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <table>
            <tr>
                <td>
                    <table>
                        <tr>
                            <td><strong>Subtotal Sin Imp</strong></td>
                        </tr>
                        <tr>
                            <td style="text-align: right">$@Html.DisplayFor(model => model.NotaDebito.Subtotal_sin_impuestos)</td>
                        </tr>
                    </table>
                </td>
                <td>
                    <table>
                        <tr>
                            <td>
                                <strong>Descuento</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right">
                                $@Html.DisplayFor(model => model.NotaDebito.Total_descuento)
                            </td>
                        </tr>
                    </table>
                </td>
                <td>
                    <table>
                        <tr>
                            <td>
                                <strong>Iva</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right">
                                $@Html.DisplayFor(model => model.NotaDebito.Valor_iva)
                            </td>
                        </tr>
                    </table>
                </td>
                <td>
                    <table>
                        <tr>
                            <td>
                                <strong>Total</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right">
                                $@Html.DisplayFor(model => model.NotaDebito.Total)
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <br/>
        <div style="font-size: small">
            @Html.Raw(Model.Impresion.mensajes)
        </div>

        @if (Model.Impresion.firma)
        {
            <div>
                <p>----------------------------------------------------------</p>
                   Firma
            </div>
        }
    </div>
</body>
</html>