@model Facturacion_Electronica.Models.Factura.ModeloImpresionFactura
@{

}

@Html.HiddenFor(model => model.Factura.id, new { id = "sale-id", Value = Model.Factura.id })

@Scripts.Render("~/bundles/jquery")
<script type="text/javascript">
    $(document).ready(function () {
        PrintSale();
    });

    function PrintSale() {
        var id = $("#sale-id").val();
        window.open("/Factura/Index/", "_self");
        window.open("/Factura/Impresion/" + id, "", 1200, 1000);
        return false;
    }
</script>