@model Facturacion_Electronica.Models.Producto.ModeloBuscarProducto

@{
    ViewBag.Title = "Producto";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* Contenedor principal */
    .dropdown {
        position: relative;
        display: inline-block;
    }

    /* Botón de tres puntos */
    .dropdown-btn {
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: #999;
        padding: 6px;
    }

        .dropdown-btn:hover {
            color: #333;
        }

    /* Menú oculto por defecto */
    .dropdown-menu {
        display: none;
        position: absolute;
        right: 100%;
        left: auto;
        top: 30px; /* se ajusta dinámicamente */
        bottom: auto; /* se ajusta dinámicamente */
        background: #fff;
        min-width: 160px;
        border-radius: 8px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.12);
        padding: 8px 0;
        z-index: 10;
    }

    /* Items del menú */
    .dropdown-item {
        padding: 10px 15px;
        font-size: 14px;
        color: #333;
        cursor: pointer;
    }

        .dropdown-item:hover {
            background: #f5f7fa;
        }

    /* Línea divisoria */
    .dropdown-divider {
        height: 1px;
        background: #e6e6e6;
        margin: 6px 0;
    }

    /* Opción eliminar */
    .dropdown-item.delete {
        color: #e15241;
    }

        .dropdown-item.delete:hover {
            background: #ffe7e5;
        }

    /* Mostrar menú */
    .dropdown.show .dropdown-menu {
        display: block;
    }
    /* Última columna sticky */
    table td:last-child,
    table th:last-child {
        position: sticky;
        right: 0;
        background: #fff; /* para que no se vea el scroll debajo */
        z-index: 10; /* para que quede por encima del resto */
    }

    .pagination {
        display: flex;
        gap: 6px;
        margin-top: 20px;
        justify-content: center;
    }

        .pagination button {
            padding: 6px 12px;
            border: 1px solid #d1d5db;
            background: white;
            cursor: pointer;
            border-radius: 6px;
        }

            .pagination button.active {
                background: #0073ff;
                color: white;
                border-color: #0073ff;
            }

    .btn-clean {
        border: none;
        outline: none;
        background: none;
        padding: 0;
        cursor: pointer;
        text-align: left; 
        width: 100%;
    }
</style>

<script>
    const filasPorPagina = 10;
    let paginaActual = 1;

    function mostrarTabla(pagina) {
        const tabla = document.getElementById("table-pagination");
        const tbody = tabla.querySelector("tbody");
        const filas = tbody.querySelectorAll("tr");

        const totalFilas = filas.length;
        const totalPaginas = Math.ceil(totalFilas / filasPorPagina);

        // Ocultar todas las filas
        filas.forEach(f => f.style.display = "none");

        // Mostrar solo las filas que corresponden a la página
        const inicio = (pagina - 1) * filasPorPagina;
        const fin = inicio + filasPorPagina;

        for (let i = inicio; i < fin && i < totalFilas; i++) {
            filas[i].style.display = "";
        }

        generarBotones(totalPaginas, pagina);
    }

    function generarBotones(total, actual) {
        const contenedor = document.getElementById("paginacion");
        contenedor.innerHTML = "";

        for (let i = 1; i <= total; i++) {
            const btn = document.createElement("button");
            btn.textContent = i;

            if (i === actual) btn.classList.add("active");

            btn.addEventListener("click", () => {
                paginaActual = i;
                mostrarTabla(paginaActual);
            });

            contenedor.appendChild(btn);
        }
    }

    // Iniciar paginado
    mostrarTabla(paginaActual);
</script>

