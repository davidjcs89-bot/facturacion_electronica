@model Facturacion_Electronica.Models.Transportista.ModeloBuscarTransportista

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Transportistas</h2>

<p>
    <button type="button" id="nuevoTransportistaBtn" class="btn bg-info" data-target="#nuevoTransportista">
        Crear Transportista
    </button>
</p>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
<div class="container" style="border-style: solid;">

    <div class="accordion" id="accordion2">
        <div class="accordion-group">
            <div class="accordion-heading">
                <h4 class="mb-0">
                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion2" href="#collapseTwo" style="color: #656565;">
                        <span class="glyphicon glyphicon-plus"></span>
                        Busqueda de Transportistas
                    </a>
                </h4>
            </div>
            <div id="collapseTwo" class="accordion-body collapse-show ">
                <div class="accordion-inner">
                    <fieldset>

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="form-group">
                                @Html.LabelFor(model => model.BuscarPorIdentificacion, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.BuscarPorIdentificacion, new { htmlAttributes = new { @class = "form-control", @id = "buscar-id" } })

                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.BuscarPorRazonSocial, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.BuscarPorRazonSocial, new { htmlAttributes = new { @class = "form-control", @id = "buscar-nombre" } })

                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="col-md-7">
                                            @Html.LabelFor(model => model.BuscarTodos, htmlAttributes: new { @class = "control-label", @style = "padding-right: 10px" })

                                            @Html.EditorFor(model => model.BuscarTodos)

                                        </div>
                                        <div class="col-md-5">

                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input id="btn-buscar-transportista" type="submit" value="Buscar" class="btn btn-default" />
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>

   
</div>
    <div class="table-responsive">
        <table class="table">
            <tr>
                <th>
                    Razon social
                </th>
                <th>
                    Numero Identificacion
                </th>
                <th>
                    Email
                </th>
                <th>
                    Placa
                </th>
                <th>
                    Fecha Creacion
                </th>
                <th>
                    Fecha Modificacion
                </th>
                <th></th>
            </tr>

            @foreach (var item in Model.Transportistas)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Numero_identificacion)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Correo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Placa)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.fecha_creacion)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Fecha_modificacion)
                    </td>
                    <td>
                        <button type="button" id="editarTransportista" class="btn btn-info btn-editar" data-target="#editarTransportista" onclick="CargarVistaEditarTransportista(@(item.id))">
                            Editar
                        </button>
                    </td>
                </tr>
            }

        </table>
    </div>
}

@section BodyArea {
    <div id="modalNuevoTransportista" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="add-item" data-backdrop="static">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">Crear Transportista</h4>
                </div>
                <div id="vistaNuevoTransportista">

                </div>
            </div>
        </div>
    </div>

    <div id="modalEditarTransportista" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="add-item" data-backdrop="static">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">Editar Transportista</h4>
                </div>
                <div id="vistaEditarTransportista">

                </div>
            </div>
        </div>
    </div>

}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/TransportistaJs")
}
