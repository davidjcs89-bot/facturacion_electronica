@model Facturacion_Electronica.Models.Transportista.ModeloTransportista

@{
    Layout = null;
}

@using (Html.BeginForm("Create", "Transportista", null, FormMethod.Post, new { id = "frm-nuevo-transportista", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Origen, new { @Value = Model.Origen})
    <div class="modal-body">
        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label " })
                    @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.TipoidentificacionId, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.TipoidentificacionId, (IEnumerable<SelectListItem>)ViewBag.TipoIdentificacion, null, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.TipoidentificacionId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.NumerdeIdentificacion, htmlAttributes: new { @class = "control-label  " })
                    @Html.EditorFor(model => model.NumerdeIdentificacion, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.NumerdeIdentificacion, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.Correo, htmlAttributes: new { @class = "control-label " })
                    @Html.EditorFor(model => model.Correo, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Correo, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">

                <div class="col-md-12">
                    @Html.LabelFor(model => model.Placa, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Placa, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Placa, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        </div>
        <div class="modal-footer">
            @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
            <div class="col-md-offset-2 col-md-10">
                <input type="button" value="Guardar" class="btn btn-default" onclick="CrearTransportista();" />
            </div>
        </div>
        }

        @*Scripts.Render("~/bundles/jqueryval")*@
        @Scripts.Render("~/bundles/TransportistaJs")
