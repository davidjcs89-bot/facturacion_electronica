@model Facturacion_Electronica.Models.Factura.ModeloImpresionFactura
@{
    Layout = null;
}
<html>
<head>
</head>
<body onload="window.print();">
    <div>
        <div>
            <table>
                <tr>
                    <td>
                        @Model.Factura.Emisor.Razon_social
                    </td>
                </tr>
                <tr>
                    <td>
                        RUC: @Model.Factura.Emisor.Ruc
                    </td>
                </tr>
                <tr>
                    <td>
                        Factura#: @Model.Factura.Numero
                    </td>
                </tr>
                <tr>
                    <td>
                        Clave Acceso:
                    </td>
                </tr>
                <tr>
                    <td style="font-size: small">
                        @Model.Factura.Clave_de_Acceso
                    </td>
                </tr>
            </table>
            <table>
                <tr>
                    @{
                        var date = Model.Factura.Fecha_emision.ToString("dd/MM/yyyy-HH:mm:ss");
                    }
                    <td>Fecha Emisión: @Html.DisplayFor(model => date)</td>
                </tr>
                <tr>
                    <td>
                        Id Cliente: @Html.DisplayFor(model => model.Factura.Clientes.identificacion)
                    </td>
                </tr>
                <tr>
                    <td>
                        Nombre Cliente: @Html.DisplayFor(model => model.Factura.Clientes.nombre_cliente)
                    </td>
                </tr>
                <tr>
                    <td>
                        @{
                            string address = Model.Factura.Clientes.Direccion;

                            if (address != null && Model.Factura.Clientes.Direccion.Length > 20)
                            {
                                address = Model.Factura.Clientes.Direccion.Substring(0, 20);
                            }
                        }
                        Dirección: @Html.DisplayFor(model => address)
                    </td>
                </tr>
                <tr>
                    <td>
                        Email
                    </td>
                </tr>
                <tr>
                    <td>
                        @{
                            string email = Model.Factura.Clientes.correo;

                            if (email != null && Model.Factura.Clientes.correo.Length > 24)
                            {
                                email = Model.Factura.Clientes.correo.Substring(0, 24);
                                email = email.ToUpper();
                            }
                            else
                            {
                                email = "";
                            }

                        }
                        @Html.DisplayFor(model => email)
                    </td>
                </tr>
            </table>
        </div>
        <table>
            <thead>
                <tr>
                    <th>
                        Código
                    </th>
                    <th colspan="2">
                        Producto
                    </th>
                    <th>
                        Qty
                    </th>
                    <th>
                        P.Unit
                    </th>
                    <th>
                        Descuento
                    </th>
                    <th>
                        Total
                    </th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model.Factura.Detalle_factura.ToList())
                {
                    <tr>
                        <td style="text-align: center">
                            @Html.DisplayFor(model => item.Producto.Codigo)
                        </td>
                        <td colspan="2" style="text-align: left">
                            @{
                                string descr = item.Producto.Nombre;

                                if (item.Producto.Nombre.Length > 8)
                                {
                                    descr = item.Producto.Nombre.Substring(0, 8);
                                }
                            }
                            @Html.DisplayFor(model => descr)
                        </td>
                        <td style="text-align: center">
                            @Html.DisplayFor(model => item.Cantidad)
                        </td>
                        <td style="text-align: right">
                            @Html.DisplayFor(model => item.Precio_unitario)
                        </td>
                        <td style="text-align: center">
                            @Html.DisplayFor(model => item.Descuento)
                        </td>
                        <td style="text-align: right">
                            @{
                                var subtotal = item.Sub_total - item.Descuento;
                            }
                            @Html.DisplayFor(model => subtotal)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <table>
            <tr>
                <td>
                    <table>
                        <tr>
                            <td><strong>Subtotal Sin Imp</strong></td>
                        </tr>
                        <tr>
                            <td style="text-align: right">$@Html.DisplayFor(model => model.Factura.Subtotal_sin_impuestos)</td>
                        </tr>
                    </table>
                </td>
                <td>
                    <table>
                        <tr>
                            <td>
                                <strong>Descuento</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right">
                                $@Html.DisplayFor(model => model.Factura.Total_descuento)
                            </td>
                        </tr>
                    </table>
                </td>
                <td>
                    <table>
                        <tr>
                            <td>
                                <strong>Iva</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right">
                                $@Html.DisplayFor(model => model.Factura.Valor_iva)
                            </td>
                        </tr>
                    </table>
                </td>
                <td>
                    <table>
                        <tr>
                            <td>
                                <strong>Total</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right">
                                $@Html.DisplayFor(model => model.Factura.Total)
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <table>
            <thead>
                <tr>
                    <th>Forma de pago</th>
                    <th>Valor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Factura.Detalle_pago_Factura.ToList())
                {
                    <tr>
                        <td style="text-align: left">
                            @{
                                var paymentDescription = item.Formas_de_Pago.Descripcion_form_pago.Split(':')[0];
                            }
                            @Html.DisplayFor(modelItem => paymentDescription)
                        </td>
                        <td style="text-align: right">
                            $@Html.DisplayFor(modelItem => item.Valor)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <br/>
        <div style="font-size: small">
            @Html.Raw(Model.Impresion.mensajes)
        </div>

        @if (Model.Impresion.firma)
        {
            <div>
                <p>----------------------------------------------------------</p>
                   Firma
            </div>
        }
    </div>
</body>
</html>