@model Facturacion_Electronica.Models.Factura.ModeloReporte

@{
    ViewBag.Title = "Reporte Facturación";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Reporte de Facturación</h2>
<br />
@using (Html.BeginForm("ReporteExcel", "Factura", null, FormMethod.Post, new { id = "frm-busqueda" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <div class="form-group">
            <div class="form-group">
                <label class="control-label col-md-2">Fecha Desde:</label>
                <div class="input-group date datePickerBasicDate col-md-3">
                    @Html.EditorFor(model => model.FechaDesde, new { htmlAttributes = new { @class = "form-control", Value = ViewBag.FechaDesde, @type = "text" } })
                    <span class="input-group-addon">
                        <span class="fa fa-calendar"></span>
                    </span>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-2">Fecha Hasta:</label>
                <div class="input-group date datePickerBasicDate col-md-3">
                    @Html.EditorFor(model => model.FechaHasta, new { htmlAttributes = new { @class = "form-control", Value = ViewBag.FechaHasta, @type = "text" } })
                    <span class="input-group-addon">
                        <span class="fa fa-calendar"></span>
                    </span>
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input id="btn-buscar" type="submit" value="Generar" class="btn btn-default" />
                </div>
            </div>
        </div>
    </div>
}
@section Styles {
    @Styles.Render("~/bundles/datetimePickerCss")
}
@Scripts.Render("~/bundles/moment")
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/datetimePicker")