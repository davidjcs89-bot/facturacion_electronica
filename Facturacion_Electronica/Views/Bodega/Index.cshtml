@model IEnumerable<Facturacion_Electronica.Bodegas>

@{
    ViewBag.Title = "Bodegas";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Bodegas</h2>

<p>
    <button type="button" id="crearBodega" class="btn btn-success" data-target="#nuevaBodega">
        Crear Bodega
    </button>
</p>

<div class="container" style="border-style: solid;">

    <div class="row">
        <div class="col-lg-12">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                C&oacute;digo
                            </th>
                            <th>
                                Nombre
                            </th>
                            <th>
                                Estado
                            </th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.codigo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.nombre)
                                </td>
                                <td>
                                    @if (item.activa)
                                    {
                                        <p>Activa</p>
                                    }
                                    else
                                    {
                                        <p>Inactiva</p>
                                    }
                                </td>
                                <td>
                                    <button type="button" id="edicionBodega" class="btn btn-warning btn-editar" data-target="#editarBodega" onclick="CargarVistaEditarBodega(@(item.id))">
                                        Editar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

    @section BodyArea {
        <div id="nuevaBodega" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="add-item" data-backdrop="static">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">Crear Bodega</h4>
                    </div>
                    <div id="vistaNuevaBodega">

                    </div>
                </div>
            </div>
        </div>

        <div id="editarBodega" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="add-item" data-backdrop="static">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">Editar Bodega</h4>
                    </div>
                    <div id="vistaEditarBodega">

                    </div>
                </div>
            </div>
        </div>

    }

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
        @Scripts.Render("~/bundles/BodegaJs")
    }
