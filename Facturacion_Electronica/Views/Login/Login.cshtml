@model Facturacion_Electronica.Models.Usuario.ModeloLogin

@{
    ViewBag.Title = "Iniciar Sesion";
}

<h2>Iniciar Sesion</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <a href='@Url.Action("Index", "Home")' style="color:#1982fc" class="icon-block"><i class="bi bi-arrow-left-short"></i>Regresar</a>

        <div class="form-group">
            @Html.LabelFor(model => model.Usuario, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Usuario, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Usuario, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Clave, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.PasswordFor(model => model.Clave, new { @class = "form-control", @id = "txtClave" })
                <input type="checkbox" id="ver" class="ver" onChange="hideOrShowPassword()" />
                <label class="text">Mostrar contraseña</label>
                <br />
                @Html.ValidationMessageFor(model => model.Clave, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Ingresar" class="btn btn-default" />
                <a href='@Url.Action("RecuperarUsuario", "Login")' class="btn btn-default">Recuperar Usuario</a>
                <a href='@Url.Action("RecuperarClave", "Login")' class="btn btn-default">Recuperar Clave</a>
            </div>
        </div>
    </div>
}
@section Styles {
    @Styles.Render("~/bundles/SweetAlertCss")
}
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/SweetAlert")
@Scripts.Render("~/bundles/UsuarioJs")
@if (ViewBag.MensajeActualizacion != null)
{
    <script type="text/javascript">
            swal('@ViewBag.MensajeActualizacion');
    </script>
}
@if (ViewBag.MensajeRecuperacion != null)
{
    <script type="text/javascript">
            swal('@ViewBag.MensajeRecuperacion');
    </script>
}