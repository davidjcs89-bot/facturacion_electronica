@model Facturacion_Electronica.Models.Usuario.ModeloLogin

@{
    ViewBag.Title = "Iniciar Sesion";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="general-container">
        <div class="form-container">
            
            <div class="button-back">
                <a href='@Url.Action("Index", "Home")' style="color:#1982fc" class="icon-block">
                    <img src="~/Content/Imagenes/arrow-back.svg" width="40px" alt="backto" />
                </a>
            </div>

            <div class="header-login">
                <h2>Iniciar Sesion</h2>
            </div>
            <hr class="dropdown-divider">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })


            <div class="container form">
                <div class="row">
                    <div class="col-6 col-md-3">
                        <label for="user" class="col-form-label">Usuario</label>
                    </div>
                    <div class="col-sm-6 col-md-8" id="user">
                        <input type="text" class="form-control" id="Usuario" name="Usuario">
                        <span class="text-danger">@Html.ValidationMessageFor(model => model.Usuario)</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6 col-md-3">
                        <label for="password" class="col-form-label">Contraseña</label>
                    </div>
                    <div class="col-sm-6 col-md-8" id="password">
                        <input type="password" class="form-control" id="txtClave" name="Clave">
                        <input type="checkbox" id="ver" class="ver" onChange="hideOrShowPassword()" />
                        <label class="text">Mostrar contraseña</label>
                        <span class="text-danger">@Html.ValidationMessageFor(model => model.Clave)</span>
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary">Ingresar</button>
                <div class="options">
                    <div>
                        <a href='@Url.Action("RecuperarUsuario", "Login")'>Recuperar Usuario</a>
                    </div>
                    <div>
                        <a href='@Url.Action("RecuperarClave", "Login")'>Recuperar Clave</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Styles {
    @Styles.Render("~/bundles/SweetAlertCss")
    @Styles.Render("~/bundles/LoginCSS")
}
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/SweetAlert")
@Scripts.Render("~/bundles/UsuarioJs")
@if (ViewBag.MensajeActualizacion != null)
{
    <script type="text/javascript">
            swal('@ViewBag.MensajeActualizacion');
    </script>
}
@if (ViewBag.MensajeRecuperacion != null)
{
    <script type="text/javascript">
            swal('@ViewBag.MensajeRecuperacion');
    </script>
}