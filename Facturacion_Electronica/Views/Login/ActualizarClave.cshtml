@model Facturacion_Electronica.Models.Usuario.ActualizarClave
@{
    ViewBag.Title = "Actualizar Clave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Recuperar Clave</h2>

@using (Html.BeginForm("ActualizarClave", "Login", null, FormMethod.Post, new { autocomplete = "off" }))
{

    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Codigo, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Codigo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Clave, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.PasswordFor(model => model.Clave, new { @class = "form-control", @id = "txtClave" })
                @Html.ValidationMessageFor(model => model.Clave, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ClaveComfirmada, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.PasswordFor(model => model.ClaveComfirmada, new { @class = "form-control", @id = "txtClave" })
                @Html.ValidationMessageFor(model => model.ClaveComfirmada, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Cambiar Clave" class="btn btn-default" />
                <a href='@Url.Action("Login", "Login")' class="btn btn-default">Regresar</a>
            </div>
        </div>
    </div>
}
@section Styles {
    @Styles.Render("~/bundles/SweetAlertCss")
}
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/SweetAlert")
@if (ViewBag.MensajeRecuperacion != null)
{
    <script type="text/javascript">
            swal('@ViewBag.MensajeRecuperacion');
    </script>
}