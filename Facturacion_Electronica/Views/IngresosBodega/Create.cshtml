@model Facturacion_Electronica.Models.Producto.ModeloIngresoExitencias

@{
    ViewBag.Title = "Ingreso de Existecias";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    th, td {
        padding: 10px;
        background: white; /* Importante para que no se vea transparente */
        border: 1px solid #ccc;
    }

    thead th {
        position: sticky;
        top: 0;
        background: #f8f8f8;
        z-index: 2;
    }

    tfoot td {
        position: sticky;
        bottom: 0;
        background: #f8f8f8;
        z-index: 2;
    }
</style>

<h2>Ingreso de Existecias</h2>
<hr />
@using (Html.BeginForm("CargarExistencias", "IngresosBodega", null, FormMethod.Post, new { id = "frm-ingreso-bodega", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div style="text-align:right">
        <a href='@Url.Action("DescargarPlantilla", "IngresosBodega")' class="btn btn-info">Descargar Plantilla</a>
    </div>

    <hr />
    <div class="form-horizontal">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)

        <div class="form-group">
            <label class="control-label col-md-2">Seleccionar una Bodega</label>
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.IdBodega, (IEnumerable<SelectListItem>)ViewBag.Bodegas, null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.IdBodega, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Seleccionar Archivo:</label>
            <div class="col-md-7">
                <input type="file" id="archivo" name="archivo" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" />
                @if (ViewBag.Error != null)
                {
                    <label class="control-label text-danger">@ViewBag.Error</label>
                }

            </div>
            <div class="col-md-3 pull-right">
                <button type="submit" class="btn btn-info" onclick="abrirCarga();">Cargar</button>
            </div>

        </div>
        <hr />
        <div class="table-responsive" style="height:50vh">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>
                            C&oacute;odigo Producto
                        </th>
                        <th>
                            Descripci&oacute;n Producto
                        </th>
                        <th>
                            Cantidad
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @for (var i = 0; i < Model.detalle.Count; i++)
                    {
                    <tr>
                        @Html.HiddenFor(model => model.detalle[i].producto.Id)
                        @Html.HiddenFor(model => model.detalle[i].producto.CodigoPrincipal)
                        <td>
                            @Html.EditorFor(model => model.detalle[i].producto.CodigoPrincipal, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })

                        </td>
                        <td>
                            @Html.EditorFor(model => model.detalle[i].producto.Nombre, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })

                        </td>
                        <td>
                            @Html.EditorFor(model => model.detalle[i].Cantidad, new { htmlAttributes = new { @class = "form-control" } })
                        </td>

                    </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>
                        </td>
                        <td>
                            <strong>TOTAL</strong>
                        </td>
                        <td>
                            @{
                                var total = Model.detalle.Sum(x => x.Cantidad);
                            }
                            <strong>@total</strong>
                        </td>

                    </tr>
                </tfoot>
            </table>
        </div>
    </div>


    <div class="form-group">
        <div class="col-md-12" style="text-align:center">
            <input type="button" value="Guardar" class="btn btn-info" onclick="IngresarInventario();" />
        </div>
    </div>
}

@section Styles {
    @Styles.Render("~/bundles/datetimePickerCss")
    @Styles.Render("~/bundles/SweetAlertCss")
}

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/SweetAlert")
@Scripts.Render("~/bundles/IngresoBodegasJs")