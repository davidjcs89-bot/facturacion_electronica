# Conexion a Supabase (rol dedicado app_facturacion, pooler en modo transaccion)
DATABASE_URL=postgresql://app_facturacion.REF:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Secreto para firmar la sesion (cadena aleatoria larga)
SESSION_SECRET=
# true para permitir enviar comprobantes al SRI desde esta app
EMISION_HABILITADA=false
# Clave para cifrar las claves de las firmas electronicas guardadas
FIRMAS_SECRET=
